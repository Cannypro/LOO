# Copy this file to .env.local and fill in your Supabase project details.
# These are safe to expose in a browser ONLY when Row Level Security is enabled
# and all tables/storage buckets have the policies in supabase/schema.sql.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Do not put Supabase service_role keys, database passwords, or private secrets here.
